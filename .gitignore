# --- WordPress core (managed by the host / WP updates, not git) ---
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/xmlrpc.php
/license.txt
/readme.html

# Never commit configuration or credentials
wp-config.php
wp-config-*.php
.env
.env.*
*.sql
*.sql.gz

# --- wp-content: track custom code only ---
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/backup*/
/wp-content/litespeed/
/wp-content/index.php
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/debug.log

# Third-party themes/plugins are installed via WP admin, not tracked.
# Un-ignore specific custom themes/plugins explicitly as they are built.
/wp-content/themes/twentytwenty*/
/wp-content/plugins/litespeed-cache/
/wp-content/plugins/akismet/
/wp-content/plugins/hello.php

# --- Tooling ---
node_modules/
vendor/
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
